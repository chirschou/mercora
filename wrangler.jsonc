/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "melt",
  "main": "worker.ts",
  "triggers": {
    // Recovery queues: every 5m; Admin BI: every 6h; recommendations: daily at 08:15 UTC.
    "crons": ["*/5 * * * *", "0 */6 * * *", "15 8 * * *"]
  },
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  /**
   * Tail Worker consumer: commerce.telemetry.v1 events flow to the deployed
   * commerce-observability-tail Worker (alert cooldown DO + email alerting).
   * The consumer must exist on the account before this is deployed; it was
   * deployed 2026-09-03 (version 5ba50573). See workers/observability-tail/.
   */
  "tail_consumers": [
    { "service": "commerce-observability-tail" }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "melt-party-db",
      "database_id": "1060d1e5-3b7f-4ef1-90aa-3c7a6a0d64a8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "melt-party-images"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "melt-party-images"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "melt-party-index"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "WEB_VITALS",
      "dataset": "melt_party_web_vitals"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": []
  },
  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": { "mode": "smart" },

  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */

  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  "vars": {
    // NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY are
    // deliberately absent: they come from the Workers Builds Build variables (or the
    // local shell when deploying by hand) and are inlined at build time.
    // Clerk 生产前端域；写入构建期 CSP 的 script-src/connect-src/frame-src，缺失则 clerk-js 被拦截。
    "NEXT_PUBLIC_CLERK_HOST": "https://clerk.melt.party",
    "NEXT_PUBLIC_IMAGE_CDN": "https://images.melt.party",
    // zone melt.party 未开启 Image Transformations，/cdn-cgi/image/ 返回 404；关闭后直出原图。开启后再改回 true。
    "NEXT_PUBLIC_IMAGE_TRANSFORMS": "false",
    "NEXT_PUBLIC_SITE_URL": "https://melt.party",
    // Deploy-time fallback for getActiveTheme() (D-10). Must also be added
    // as a Workers Build variable in the Cloudflare Dashboard per the
    // project rule for NEXT_PUBLIC_* vars (see 06-02 user setup).
    "NEXT_PUBLIC_THEME_DEFAULT": "glacier-night",
    // Subscriptions (docs/subscriptions.md). Reconciliation must stay on once
    // the first subscription exists; disable acquisition first to stop sales.
    // The terms version must match the recurring-terms section published on
    // the Terms of Service page.
    "STORE_FEATURE_SUBSCRIPTION_RECONCILIATION": "true",
    "STORE_FEATURE_SUBSCRIPTION_ACQUISITION": "true",
    "STORE_SUBSCRIPTION_TERMS_VERSION": "2026-11-09",
    // Gift cards (docs/runtime-configuration.md). Reconciliation must be
    // deployed and verified before acquisition, because enabling acquisition
    // without reconciliation throws at capability resolution; disable
    // acquisition first to stop new sales, and keep reconciliation on while
    // any gift-card balance or reservation exists.
    "STORE_FEATURE_GIFT_CARD_RECONCILIATION": "true",
    "STORE_FEATURE_GIFT_CARD_ACQUISITION": "true",
    "EMAIL_PROVIDER": "cloudflare",
    // Sender must be on a domain onboarded to Cloudflare Email Sending in this account.
    "STORE_SENDER_EMAIL": "Melt Party <orders@mail.melt.party>",
    "STORE_SUPPORT_EMAIL": "support@melt.party",
    // 公开展示值；tel 链接按 E.164 取其中的 + 与数字，非法值视为未配置。
    "STORE_SUPPORT_PHONE": "+1 (929) 206-2531",
    "STORE_POSTAL_ADDRESS": "Unit 1523A, 15/F, Star House, 3 Salisbury Road, Tsim Sha Tsui, Kowloon, Hong Kong"
  },
  /**
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */

  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": { "directory": "./public/", "binding": "ASSETS" },

  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
